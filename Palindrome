#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#define MAX_SIZE 19
int isVowel(char ch) {
    if (ch >= 'A' && ch <= 'Z') {
        ch = ch + 32;
    }
    return (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u');
}
int isPalindrome(char str[]) {
    int start = 0;
    int end = strlen(str) - 1;
    while (start < end) {
        if (str[start] != str[end]) {
            return 0;
        }
        start++;
        end--;
    }
    return 1;
}

int main() {
    int fd1[2];
    int fd2[2];
    pid_t p2_pid, p3_pid;
    if (pipe(fd1) == -1) {
        perror("pipe1 (fd1) creation failed");
        return 1;
    }
    if (pipe(fd2) == -1) {
        perror("pipe2 (fd2) creation failed");
        return 1;
    }
    p2_pid = fork();

    if (p2_pid < 0) {
        perror("Fork P2 failed");
        return 1;
    }

    if (p2_pid == 0) {
        p3_pid = fork();

        if (p3_pid < 0) {
            perror("Fork P3 failed");
            return 1;
        }

        if (p3_pid == 0) {

            char p3_str[MAX_SIZE];
            close(fd1[0]);
            close(fd1[1]);
            close(fd2[1]);
            read(fd2[0], p3_str, sizeof(p3_str));
            close(fd2[0]);
            printf("[P3] Received string: '%s'\n", p3_str);
            if (isPalindrome(p3_str)) {
                printf("[P3] Result: The string IS a palindrome.\n");
            } else {
                printf("[P3] Result: The string IS NOT a palindrome.\n");
            }
            exit(0);
        } else {
            char p2_str[MAX_SIZE];
            int vowel_count = 0;
            int i;
            close(fd1[1]);
            close(fd2[0]);
            read(fd1[0], p2_str, sizeof(p2_str));
            close(fd1[0]);


            for ( i = 0; p2_str[i] != '\0'; i++) {
                if (isVowel(p2_str[i])) {
                    vowel_count++;
                }
            }
            printf("[P2] Received string: '%s'\n", p2_str);
            printf("[P2] Vowel Count: %d\n", vowel_count);
            write(fd2[1], p2_str, strlen(p2_str) + 1);
            close(fd2[1]);
            wait(NULL);
            exit(0);
        }
    } else {
        char p1_str[MAX_SIZE];

        close(fd1[0]);
        close(fd2[0]);
        close(fd2[1]);
        printf("[P1] Enter a string (max 18 chars): ");
        if (fgets(p1_str, sizeof(p1_str), stdin) != NULL) {
            p1_str[strcspn(p1_str, "\n")] = '\0';
        }
        write(fd1[1], p1_str, strlen(p1_str) + 1);
        close(fd1[1]);
        wait(NULL);
    }

    return 0;
}
