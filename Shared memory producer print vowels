#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/shm.h>

#define SIZE 100
#define KEY_FILE "ipc_key"
#define PROJECT_ID 'C'

int main()
{
    key_t key;
    int shmid;
    char *shared_memory;
    char str[SIZE];

    /* Create/access key file */
    FILE *fp = fopen(KEY_FILE, "a");

    if (fp == NULL)
    {
        perror("Producer: fopen key file");
        return 1;
    }

    fclose(fp);

    /* Generate key */
    key = ftok(KEY_FILE, PROJECT_ID);

    if (key == -1)
    {
        perror("Producer: ftok");
        return 1;
    }

    /* Create shared memory */
    shmid = shmget(key, SIZE + 1, IPC_CREAT | 0666);

    if (shmid == -1)
    {
        perror("Producer: shmget");
        return 1;
    }

    /* Attach shared memory */
    shared_memory = (char *)shmat(shmid, NULL, 0);

    if (shared_memory == (char *)-1)
    {
        perror("Producer: shmat");
        return 1;
    }

    /* Flag = 0 */
    shared_memory[0] = 0;

    printf("Producer: Enter a string: ");
    fflush(stdout);

    if (fgets(str, SIZE, stdin) == NULL)
    {
        perror("Producer: fgets");
        shmdt(shared_memory);
        return 1;
    }

    str[strcspn(str, "\n")] = '\0';

    /* Store string */
    strcpy(shared_memory + 1, str);

    /* Tell consumer data is ready */
    shared_memory[0] = 1;

    printf("Producer: String written to shared memory.\n");

    /* Detach */
    if (shmdt(shared_memory) == -1)
    {
        perror("Producer: shmdt");
        return 1;
    }

    return 0;
}
