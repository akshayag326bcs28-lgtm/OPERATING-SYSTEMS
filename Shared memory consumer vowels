#include <stdio.h>
#include <stdlib.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <unistd.h>

#define SIZE 100
#define KEY_FILE "ipc_key"
#define PROJECT_ID 'C'

int main()
{
    key_t key;
    int shmid;
    char *shared_memory;

    /* Access key file */
    FILE *fp = fopen(KEY_FILE, "a");

    if (fp == NULL)
    {
        perror("Consumer: fopen key file");
        return 1;
    }

    fclose(fp);

    /* Generate same key */
    key = ftok(KEY_FILE, PROJECT_ID);

    if (key == -1)
    {
        perror("Consumer: ftok");
        return 1;
    }

    /* Access shared memory */
    shmid = shmget(key, SIZE + 1, 0666);

    if (shmid == -1)
    {
        perror("Consumer: shmget");
        return 1;
    }

    /* Attach */
    shared_memory = (char *)shmat(shmid, NULL, 0);

    if (shared_memory == (char *)-1)
    {
        perror("Consumer: shmat");
        return 1;
    }

    /* Wait for producer */
    while (shared_memory[0] == 0)
    {
        usleep(10000);
    }

    printf("\nConsumer: String read from shared memory: %s\n",
           shared_memory + 1);

    printf("Consumer: Vowels are: ");

    int i;

    for (i = 0; shared_memory[i + 1] != '\0'; i++)
    {
        char ch = shared_memory[i + 1];

        if (ch == 'a' || ch == 'e' || ch == 'i' ||
            ch == 'o' || ch == 'u' ||
            ch == 'A' || ch == 'E' || ch == 'I' ||
            ch == 'O' || ch == 'U')
        {
            printf("%c ", ch);
        }
    }

    printf("\n");

    /* Detach */
    if (shmdt(shared_memory) == -1)
    {
        perror("Consumer: shmdt");
        return 1;
    }

    /* Remove shared memory */
    if (shmctl(shmid, IPC_RMID, NULL) == -1)
    {
        perror("Consumer: shmctl");
        return 1;
    }

    return 0;
}
