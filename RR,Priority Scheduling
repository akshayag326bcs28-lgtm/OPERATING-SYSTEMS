#include <stdio.h>
#include "head.h"

void fcfs(struct process p[], int n) {
    int i, j;
    struct process temp;
    struct process temp_p[MAX];
    float total_wt = 0, total_tat = 0;
    for (i = 0; i < n; i++) temp_p[i] = p[i];
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (temp_p[j].at > temp_p[j + 1].at) {
                temp = temp_p[j];
                temp_p[j] = temp_p[j + 1];
                temp_p[j + 1] = temp;
            }
        }
    }

    float current_time = 0.0;
    for (i = 0; i < n; i++) {
        if (current_time < temp_p[i].at) {
            current_time = temp_p[i].at;
        }
        temp_p[i].ct = current_time + temp_p[i].bt;
        temp_p[i].tat = temp_p[i].ct - temp_p[i].at;
        temp_p[i].wt = temp_p[i].tat - temp_p[i].bt;

        current_time = temp_p[i].ct;
        total_wt += temp_p[i].wt;
        total_tat += temp_p[i].tat;
    }

    printf("\n--- FCFS Scheduling ---\n");
    printf("Process\tArrival\tBurst\tComplete\tWaiting\tTurnaround\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t%.2f\t%.2f\t%.2f\t\t%.2f\t%.2f\n", temp_p[i].pid, temp_p[i].at, temp_p[i].bt, temp_p[i].ct, temp_p[i].wt, temp_p[i].tat);
    }
    printf("\nAverage Waiting Time: %.2f\n", total_wt / n);
    printf("Average Turnaround Time: %.2f\n", total_tat / n);
}

void sjf(struct process p[], int n) {
    int i, completed = 0;
    float current_time = 0.0;
    int is_completed[MAX] = {0};
    struct process temp_p[MAX];
    float total_wt = 0, total_tat = 0;

    for (i = 0; i < n; i++) temp_p[i] = p[i];

    while (completed < n) {
        int idx = -1;
        float min_bt = 1e9;

        for (i = 0; i < n; i++) {
            if ((temp_p[i].at <= current_time || (temp_p[i].at - current_time) < 1e-6) && is_completed[i] == 0) {
                if (temp_p[i].bt < min_bt) {
                    min_bt = temp_p[i].bt;
                    idx = i;
                } else if (temp_p[i].bt == min_bt) {
                    if (temp_p[i].at < temp_p[idx].at) {
                        idx = i;
                    }
                }
            }
        }

        if (idx != -1) {
            temp_p[idx].ct = current_time + temp_p[idx].bt;
            temp_p[idx].tat = temp_p[idx].ct - temp_p[idx].at;
            temp_p[idx].wt = temp_p[idx].tat - temp_p[idx].bt;
            is_completed[idx] = 1;

            current_time = temp_p[idx].ct;
            total_wt += temp_p[idx].wt;
            total_tat += temp_p[idx].tat;
            completed++;
        } else {
            float next_arrival = 1e9;
            for(i = 0; i < n; i++) {
                if(is_completed[i] == 0 && temp_p[i].at > current_time && temp_p[i].at < next_arrival) {
                    next_arrival = temp_p[i].at;
                }
            }
            current_time = (next_arrival == 1e9) ? current_time + 1.0 : next_arrival;
        }
    }

    printf("\n--- Non-Preemptive SJF Scheduling ---\n");
    printf("Process\tArrival\tBurst\tComplete\tWaiting\tTurnaround\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t%.2f\t%.2f\t%.2f\t\t%.2f\t%.2f\n", temp_p[i].pid, temp_p[i].at, temp_p[i].bt, temp_p[i].ct, temp_p[i].wt, temp_p[i].tat);
    }
    printf("\nAverage Waiting Time: %.2f\n", total_wt / n);
    printf("Average Turnaround Time: %.2f\n", total_tat / n);
}

void srtf(struct process p[], int n) {
    int i, completed = 0;
    float current_time = 0.0;
    float rem_bt[MAX];
    struct process temp_p[MAX];
    float total_wt = 0, total_tat = 0;

    for (i = 0; i < n; i++) {
        temp_p[i] = p[i];
        rem_bt[i] = p[i].bt;
    }

    while (completed < n) {
        int idx = -1;
        float min_rem = 1e9;

        for (i = 0; i < n; i++) {
            if ((temp_p[i].at <= current_time || (temp_p[i].at - current_time) < 1e-6) && rem_bt[i] > 0) {
                if (rem_bt[i] < min_rem) {
                    min_rem = rem_bt[i];
                    idx = i;
                } else if (rem_bt[i] == min_rem) {
                    if (temp_p[i].at < temp_p[idx].at) {
                        idx = i;
                    }
                }
            }
        }

        if (idx != -1) {
            float time_step = 0.01;
            rem_bt[idx] -= time_step;
            current_time += time_step;

            if (rem_bt[idx] <= 1e-6) {
                temp_p[idx].ct = current_time;
                temp_p[idx].tat = temp_p[idx].ct - temp_p[idx].at;
                temp_p[idx].wt = temp_p[idx].tat - temp_p[idx].bt;

                total_wt += temp_p[idx].wt;
                total_tat += temp_p[idx].tat;
                completed++;
            }
        } else {
            float next_arrival = 1e9;
            for(i = 0; i < n; i++) {
                if(rem_bt[i] > 0 && temp_p[i].at > current_time && temp_p[i].at < next_arrival) {
                    next_arrival = temp_p[i].at;
                }
            }
            current_time = (next_arrival == 1e9) ? current_time + 0.01 : next_arrival;
        }
    }

    printf("\n--- SRTF (Preemptive SJF) Scheduling ---\n");
    printf("Process\tArrival\tBurst\tComplete\tWaiting\tTurnaround\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t%.2f\t%.2f\t%.2f\t\t%.2f\t%.2f\n", temp_p[i].pid, temp_p[i].at, temp_p[i].bt, temp_p[i].ct, temp_p[i].wt, temp_p[i].tat);
    }
    printf("\nAverage Waiting Time: %.2f\n", total_wt / n);
    printf("Average Turnaround Time: %.2f\n", total_tat / n);
}

