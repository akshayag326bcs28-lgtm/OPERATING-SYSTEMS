#include <stdio.h>
#include "head.h"
int main() {
    struct process p[MAX];
    int n,i, choice;
    printf("Enter number of processes: ");
    scanf("%d", &n);
    for (i = 0; i < n; i++) {
        p[i].pid = i + 1;
        printf("Process P%d -\n Arrival Time : ", p[i].pid);
        scanf("%f", &p[i].at);
        printf(" Burst Time : ");
        scanf("%f", &p[i].bt);
    }

    while (1) {
        printf("\n=== CPU Scheduling Menu ===\n");
        printf("1. FCFS\n");
        printf("2. SJF\n");
        printf("3. SRTF\n");
        printf("4. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                fcfs(p, n);
                break;
            case 2:
                sjf(p, n);
                break;
            case 3:
                srtf(p, n);
                break;
            case 4:
                printf("Exiting...");
                return 0;
            default:
                printf("Invalid option selected. Please try again.\n");
        }
    }
    return 0;
}
