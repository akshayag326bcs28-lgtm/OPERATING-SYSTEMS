#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/msg.h>

#define SIZE 100
#define KEY_FILE "ipc_key"
#define PROJECT_ID 'A'

struct message
{
    long msg_type;
    char text[SIZE];
};

int main()
{
    key_t key;
    int msgid;
    struct message msg;


    FILE *fp = fopen(KEY_FILE, "a");

    if (fp == NULL)
    {
        perror("Consumer: fopen");
        return 1;
    }

    fclose(fp);


    key = ftok(KEY_FILE, PROJECT_ID);

    if (key == -1)
    {
        perror("Consumer: ftok");
        return 1;
    }


    msgid = msgget(key, 0666);

    if (msgid == -1)
    {
        perror("Consumer: msgget");
        return 1;
    }

    /* Receive message */
    if (msgrcv(msgid, &msg, sizeof(msg.text), 1, 0) == -1)
    {
        perror("Consumer: msgrcv");
        return 1;
    }

    printf("\nConsumer: Message received: %s", msg.text);

    /* Count words */
    int count = 0;
    int inWord = 0;
    int i;

    for (i = 0; msg.text[i] != '\0'; i++)
    {
        if (msg.text[i] != ' ' &&
            msg.text[i] != '\n' &&
            msg.text[i] != '\t')
        {
            if (inWord == 0)
            {
                count++;
                inWord = 1;
            }
        }
        else
        {
            inWord = 0;
        }
    }

    printf("Consumer: Number of words = %d\n", count);


    if (msgctl(msgid, IPC_RMID, NULL) == -1)
    {
        perror("Consumer: msgctl");
        return 1;
    }

    return 0;
}
