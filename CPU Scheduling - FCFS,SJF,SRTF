int main() {
    int n, i, choice;
    float quantum = 0;

    printf("CPU Scheduling Algorithms\n");
    printf("1. Round Robin\n");
    printf("2. Priority Scheduling (non-preemptive)\n");
    printf("3. Priority Scheduling (preemptive)\n");
    printf("Enter your choice: ");
    scanf("%d", &choice);

    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process proc[n];
    int execution_order[n];

    printf("Enter Arrival Time and Burst Time for each process:\n");
    for (i = 0; i < n; i++) {
        proc[i].pid = i + 1;
        printf("P%d Arrival Time: ", i + 1);
        scanf("%f", &proc[i].at);
        printf("P%d Burst Time: ", i + 1);
        scanf("%f", &proc[i].bt);


        if (choice == 2 || choice == 3) {
            printf("P%d Priority (lower number = higher priority): ", i + 1);
            scanf("%d", &proc[i].priority);
        }
    }


    if (choice == 1) {
        printf("Enter Time Quantum: ");
        scanf("%f", &quantum);
    }

    switch (choice) {
        case 1:
            printf("\n--- Round Robin Scheduling (Quantum = %.2f) ---\n", quantum);
            runRoundRobin(proc, n, execution_order, quantum);
            printTable(proc, n, execution_order);
            break;

        case 2:
            printf("\n--- Priority Scheduling (Non-Preemptive) ---\n");
            runPriorityScheduling(proc, n, execution_order);
            printTable(proc, n, execution_order);
            break;

        case 3:
            printf("\n--- Priority Scheduling (Preemptive) ---\n");
            runPreemptivePriorityScheduling(proc, n, execution_order);
            printTable(proc, n, execution_order);
            break;

        default:
            printf("Invalid choice!\n");
            return 1;
    }

    return 0;
}
